load("@kernel_toolchain_info//:dict.bzl", "CLANG_VERSION")
load("@rules_pkg//pkg:install.bzl", "pkg_install")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("@rules_python//python:py_runtime_pair.bzl", "py_runtime_pair")
load("//build/kernel/kleaf:kernel.bzl", "kernel_build", "kernel_compile_commands")

kernel_build(
    name = "crosvm_aarch64",
    outs = [
        "System.map",
        "u-boot",
        "u-boot.bin",
    ],
    build_config = "build.config.crosvm.aarch64",
    defconfig = "configs/qemu_arm64_defconfig",
    srcarch = "..",
    check_defconfig = "disabled",
    pre_defconfig_fragments = [
        "qemu-minimal.fragment",
        "arm.fragment",
        "cuttlefish.fragment",
        "crosvm.fragment",
        "crosvm-aarch64.fragment",
    ],
    deps = [
        "//prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9:binaries",
    ],
)

kernel_compile_commands(
    name = "crosvm_aarch64_compile_commands",
    kernel_build = ":crosvm_aarch64",
)

pkg_files(
    name = "crosvm_aarch64_dist_files",
    srcs = [":crosvm_aarch64"],
    strip_prefix = strip_prefix.files_only(),
    visibility = ["//visibility:private"],
)

pkg_install(
    name = "crosvm_aarch64_dist",
    srcs = [":crosvm_aarch64_dist_files"],
    destdir = "out/u-boot/dist",
)

