# Use SWIG enabled Python
py_runtime_pair(
    name = "py_runtime_pair",
    py3_runtime = "//prebuilts/clang/host/linux-x86/clang-{}:python3".format(
        CLANG_VERSION,
    ),
)

toolchain(
    name = "py_toolchain",
    toolchain = ":py_runtime_pair",
    toolchain_type = "@bazel_tools//tools/python:toolchain_type",
)

# pylibfdt targets added/migrated for Python 3.12+ compatibility
filegroup(
    name = "libfdt_sources",
    srcs = glob([
        "scripts/dtc/libfdt/*.c",
        "scripts/dtc/libfdt/*.h",
    ]),
)

filegroup(
    name = "pylibfdt_include_dirs",
    srcs = [
        "scripts/dtc",
        "scripts/dtc/libfdt",
    ],
)

pylibfdt_swig(
    name = "pylibfdt_swig_gen",
    src = "scripts/dtc/pylibfdt/libfdt.i_shipped",
    include_dirs = [":pylibfdt_include_dirs"],
    libfdt_sources = [":libfdt_sources"],
)

filegroup(
    name = "pylibfdt_c_wrapper",
    srcs = [":pylibfdt_swig_gen"],
    output_group = "wrapper",
)

# cc_binary with linkshared = True is used instead of cc_library to build the
# Python C extension because:
# 1. It produces a standalone shared library (.so) as its default output.
# 2. It preserves the target name (_libfdt.so) without prepending the standard
#    library prefix "lib", which Python strictly requires to import the module.
cc_binary(
    name = "_libfdt.so",
    srcs = [
        ":libfdt_sources",
        ":pylibfdt_c_wrapper",
    ],
    copts = [
        # From scripts/dtc/pylibfdt/Makefile
        "-Wno-self-assign",
        "-Wno-sign-compare",
    ],
    features = ["kleaf-python-headers"],
    includes = ["scripts/dtc/libfdt"],
    linkshared = True,
)

hermetic_genrule(
    name = "generate_pylibfdt_env",
    srcs = [
        ":_libfdt.so",
        ":pylibfdt_swig_gen",
    ],
    outs = ["build.config.pylibfdt"],
    cmd = """
        echo "export KLEAF_PRECOMPILED_LIBFDT_SO=\\$$ROOT_DIR/$(execpath :_libfdt.so)" > $@
        echo "export KLEAF_PRECOMPILED_LIBFDT_PY=\\$$ROOT_DIR/$(execpath :pylibfdt_swig_gen)" >> $@
    """,
)
